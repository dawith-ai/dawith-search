{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dawith Search",
  "version": "1.3.0",
  "identifier": "com.dawith.search",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dawith Search",
        "width": 1150,
        "height": 780,
        "minWidth": 850,
        "minHeight": 550,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "resources": {
      "../bin/native/windows/x64/*.exe": "bin/native/windows/x64/",
      "../LICENSE": "licenses/LICENSE-Dawith-Search.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../native/everything-sdk/LICENSE": "licenses/LICENSE-Everything-SDK.txt",
      "../native/goz/LICENSE": "licenses/LICENSE-goz.txt",
      "../licenses/THIRD_PARTY_LICENSES-rust.txt": "licenses/THIRD_PARTY_LICENSES-rust.txt"
    },
    "icon": [
      "../src/assets/icon.png",
      "../src/assets/icon.ico"
    ]
  }
}
