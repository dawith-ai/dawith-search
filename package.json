{
  "name": "dawith-search",
  "version": "1.0.0",
  "description": "Dawith Search - Voidtools Everything Clone with AI Smart Query, Spacebar Quick Look & Mobile Remote Access",
  "main": "src/main/main.js",
  "bin": {
    "dawith-search": "bin/dawith-cli.js",
    "dawith-cli": "bin/dawith-cli.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node bin/dawith-cli.js",
    "test": "node tests/test-all-features.js",
    "lint": "node scripts/check-syntax.js",
    "check": "npm run lint && npm test",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "keywords": [
    "everything",
    "file-search",
    "desktop-search",
    "dawith",
    "instant-search"
  ],
  "author": "Dawith",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "fdir": "^6.5.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dawith.search",
    "productName": "Dawith Search",
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": false,
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "portable": {
      "artifactName": "DawithSearch-${version}-portable.exe"
    }
  }
}
