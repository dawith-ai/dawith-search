{
  "name": "dawith-search",
  "version": "1.3.0",
  "description": "Dawith Search - cross-platform local Everything-style file search with saved workspaces and Quick Look",
  "main": "src/main/main.js",
  "bin": {
    "dawith-search": "bin/dawith-cli.js",
    "dawith-cli": "bin/dawith-cli.js"
  },
  "scripts": {
    "start": "electron .",
    "start:tauri": "tauri dev",
    "cli": "node bin/dawith-cli.js",
    "benchmark:search": "node scripts/benchmark-native-search.js",
    "verify:native:win": "node scripts/verify-native-binaries.js",
    "test": "node tests/test-all-features.js && node tests/test-operations.js && node tests/test-evidence-analyzer.js && node tests/test-root-manager.js && node tests/test-update-manager.js && node tests/test-local-indexing.js && node tests/test-converter.js",
    "test:e2e": "node tests/test-electron-e2e.js",
    "lint": "node scripts/check-syntax.js && node scripts/check-renderer-contract.js && npm run test:tauri-contract",
    "check": "npm run lint && npm test",
    "build": "electron-builder",
    "build:goz:win": "node scripts/build-goz.js",
    "build:everything-ipc:win": "node scripts/build-everything-ipc.js",
    "build:win": "npm run build:everything-ipc:win && npm run build:goz:win && npm run verify:native:win && node scripts/create-windows-icon.js && electron-builder --win --x64 --publish never",
    "build:win:arm64": "node scripts/build-goz.js --arch arm64 && node scripts/verify-native-binaries.js --arch arm64 && node scripts/create-windows-icon.js && electron-builder --win --arm64 --publish never",
    "build:mac": "electron-builder --mac --universal --publish never",
    "build:tauri": "npm run build:everything-ipc:win && npm run build:goz:win && npm run verify:native:win && tauri build",
    "test:tauri-contract": "node scripts/check-tauri-contract.js",
    "verify:tauri": "node scripts/verify-tauri-artifacts.js"
  },
  "keywords": [
    "everything",
    "file-search",
    "desktop-search",
    "dawith",
    "instant-search"
  ],
  "author": "Dawith",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dawith.search",
    "productName": "Dawith Search",
    "icon": "src/assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ko"
    ],
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json",
      "!src/**/*.map",
      "!node_modules/**/*.map",
      "!node_modules/pdf-lib/dist{,/**/*}",
      "!node_modules/pdf-lib/es{,/**/*}",
      "!node_modules/pdf-lib/src{,/**/*}",
      "!tests{,/**/*}",
      "!scripts{,/**/*}",
      "!site{,/**/*}",
      "!*.md"
    ],
    "forceCodeSigning": false,
    "asarUnpack": [
      "bin/native/**/*.exe"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        "portable",
        "nsis-web"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "src/assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "portable": {
      "artifactName": "DawithSearch-${version}-portable.exe"
    },
    "nsisWeb": {
      "artifactName": "DawithSearch-${version}-web-setup.exe"
    }
  }
}
