{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dawith Search",
  "version": "1.2.1",
  "identifier": "com.dawith.search",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dawith Search",
        "width": 1150,
        "height": 780,
        "minWidth": 850,
        "minHeight": 550,
        "decorations": false,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "resources": { "../bin/native/windows/x64/*.exe": "bin/native/windows/x64/" },
    "icon": ["../src/assets/icon.png", "../src/assets/icon.ico"]
  }
}

